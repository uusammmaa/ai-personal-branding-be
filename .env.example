# Copy to .env and fill in values. Never commit .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Pinecone (integrated or serverless index)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-documents

# Supabase pgvector — use the service role key on the FastAPI server only
SUPABASE_URL=
SUPABASE_KEY=

# Alternative env name for the same secret (either works):
# SUPABASE_SERVICE_ROLE_KEY=

# Default store when the client does not send vector_store
VECTOR_STORE=pinecone

